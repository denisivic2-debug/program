generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  role          String    @default("Employee") // Admin, Manager, Employee, Auditor
  employeeId    String?   @unique
  employee      Employee? @relation(fields: [employeeId], references: [id])
  createdTasks  Task[]    @relation("CreatedBy")
  comments      TaskComment[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Employee {
  id             String      @id @default(uuid())
  firstName      String
  lastName       String
  email          String      @unique
  phone          String?
  position       String
  departmentId   String
  department     Department  @relation(fields: [departmentId], references: [id])
  employmentDate DateTime    @default(now())
  status         String      @default("Active") // Active, Inactive
  profilePhoto   String?
  user           User?
  assignedTasks  Task[]      @relation("AssignedTo")
  originatedTasks Task[]     @relation("Originator")
  registeredTasks Task[]     @relation("Registrar")
  smilTasks      Task[]      @relation("SMILAssignee")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  managerId   String?
  employees   Employee[]
  tasks       Task[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Task {
  id           String        @id @default(uuid())
  title        String
  description  String?
  priority     String        @default("Medium") // Low, Medium, High
  status       String        @default("Pending") // Pending, In Progress, Waiting, Completed, Cancelled, Overdue
  createdById  String
  createdBy    User          @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   Employee?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  // Originator (Source person/judge)
  originatorId String?
  originator   Employee?     @relation("Originator", fields: [originatorId], references: [id])

  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id])
  dueDate      DateTime?
  
  // Linking tasks
  parentTaskId String?
  parentTask   Task?         @relation("TaskLinks", fields: [parentTaskId], references: [id])
  childTasks   Task[]        @relation("TaskLinks")

  // New fields for Case Management
  category      String        @default("Parnica") // Parnica (Green), Krivica (Pink), Prekršaji (White)
  caseNumber    String?
  registrarId   String?
  registrar     Employee?     @relation("Registrar", fields: [registrarId], references: [id])
  smilAssigneeId String?
  smilAssignee  Employee?     @relation("SMILAssignee", fields: [smilAssigneeId], references: [id])

  comments     TaskComment[]
  history      TaskHistory[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model TaskHistory {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id])
  changedBy    String
  changeType   String   @default("StatusChange") // StatusChange, AssignmentChange, LinkingChange
  oldValue     String?
  newValue     String
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
